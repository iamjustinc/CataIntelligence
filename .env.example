# Copy to .env (or run `pnpm setup:env` to generate one with random local secrets).
# Placeholder values only. Never commit real secrets.

# --- Database -------------------------------------------------------------
# Owner role: runs migrations only. Must be able to create tables and roles.
DATABASE_ADMIN_URL=postgres://catalog_owner:change-me@127.0.0.1:54329/catalog_intelligence
# Application role: non-owner, subject to row-level security. Used by web and worker.
DATABASE_URL=postgres://catalog_app:change-me@127.0.0.1:54329/catalog_intelligence
# Port for the optional project-local PostgreSQL cluster (`pnpm db:up`).
PG_LOCAL_PORT=54329

# --- Authentication -------------------------------------------------------
# 32+ random bytes. Required; production startup fails without it.
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
APP_BASE_URL=http://localhost:3000
# Password assigned to seeded demo identities by `pnpm db:seed`.
SEED_USER_PASSWORD=change-me

# --- AI provider (server-side only) ----------------------------------------
# Default mode for new workspaces: demo (deterministic fixtures, labeled), live, or off.
AI_PROVIDER_MODE=demo
# Required for live mode. Missing values degrade to manual workflows ("AI unavailable");
# demo fixtures are never substituted. The key is read by the server and worker only.
ANTHROPIC_API_KEY=
# Default model for workspaces that do not set their own in Settings, for example claude-opus-5-5.
# No model is assumed when this is empty.
AI_MODEL_ID=

# --- Storage and jobs -------------------------------------------------------
STORAGE_DIR=.data/storage
# Provider calls in flight per job (1 to 8).
JOB_CONCURRENCY=2
# Worker tuning (optional): poll interval, lease length, pause between provider calls, health port.
# WORKER_POLL_MS=1000
# WORKER_LEASE_SECONDS=60
# WORKER_ITEM_DELAY_MS=0
# WORKER_HEALTH_PORT=3001
# Uploads allowed per user per minute.
# UPLOAD_RATE_LIMIT_PER_MINUTE=30
JOB_TOKEN_CAP=400000
JOB_SPEND_CAP_USD=5
DAILY_WORKSPACE_SPEND_CAP_USD=20
